# Dipakai di VPS (lihat docker-compose.prebuilt.yml): web sudah di-build di laptop oleh tools/deploy.sh,
# jadi image ini hanya menyalin hasilnya. Tidak ada npm install atau next build di server 1 vCPU.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY .deploy/web/ ./
EXPOSE 3000
CMD ["node", "server.js"]
