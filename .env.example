# ===== Paham Emiten environment =====
# Copy ke .env lalu isi. JANGAN commit .env (repo wajib bersih dari key).
# Untuk menjalankan Paham Emiten TIDAK ada yang perlu diisi: default-nya offline (snapshot Sectors di
# fixtures/snapshot, 0 kredit) dan tanpa LLM. Prefiks IDXMACA_* adalah nama warisan, sengaja tidak diganti.

# --- Mode Store (docs/STORE.md) ---
IDXMACA_STORE_MODE=offline         # offline (snapshot, 0 kredit) | live (panen, butuh SECTORS_API_KEY)

# --- Sectors (HANYA dibaca oleh Store Service; cukup diisi saat panen snapshot dengan IDXMACA_STORE_MODE=live) ---
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app
SECTORS_AUTH_SCHEME=
# Sectors memakai apiKey mentah di header Authorization (spec apiKey). Kosongkan; isi 'Bearer' hanya bila Sectors mengubah skema.

# --- Layanan & data ---
IDXMACA_STORE_URL=http://127.0.0.1:8787
IDXMACA_DATA_DIR=./.data
CORE_URL=http://127.0.0.1:8788     # dipakai web (Next.js) untuk proxy, di docker: http://core:8788

# Saldo awal untuk credit_remaining di GET /v1/store/stats (sumber resmi tetap portal hackathon;
# Paham Emiten tidak menampilkannya).
IDXMACA_CREDIT_START=1000
