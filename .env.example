# ===== IDXMACA environment =====
# Copy ke .env lalu isi. JANGAN commit .env (repo wajib bersih dari key).

# --- Mode demo/dev (default): fixture JSON, 0 kredit Sectors, tanpa key ---
IDXMACA_STORE_MODE=fixture          # fixture | offline | live | auto
IDXMACA_LLM_MODE=auto               # auto | live | template  (auto = live bila OPENROUTER_API_KEY ada)

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
IDXMACA_MODEL=meta/muse-spark-1.3
IDXMACA_LLM_TIMEOUT=120
IDXMACA_LLM_RETRIES=3
IDXMACA_MAX_LLM_USD_PER_RUN=1.50

# --- Sectors (HANYA dibaca oleh Store Service) ---
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app
SECTORS_AUTH_SCHEME=
# Sectors memakai apiKey mentah di header Authorization (spec apiKey). Kosongkan; isi 'Bearer' hanya bila Sectors mengubah skema.
IDXMACA_ALLOW_FIXTURE_FALLBACK=1

# --- Budget & paralelisme ---
IDXMACA_MAX_CREDITS_PER_RUN=60
IDXMACA_MAX_PARALLEL=6

# --- Layanan & data ---
IDXMACA_STORE_URL=http://127.0.0.1:8787
IDXMACA_DATA_DIR=./.data
IDXMACA_FIXTURES_DIR=./fixtures/sectors
CORE_URL=http://127.0.0.1:8788     # dipakai web (Next.js) untuk proxy, di docker: http://core:8788

# --- Memori sesi ---
IDXMACA_HISTORY_TURNS=10
# Saldo awal kredit Sectors untuk chip "sisa" (sumber resmi tetap portal hackathon).
IDXMACA_CREDIT_START=1000
