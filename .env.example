# Sectors Financial API
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app/v2
SECTORS_TIMEOUT_MS=45000

# OpenRouter (LLM narasi + Jev decisions)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_REASONING_EFFORT=high
JEV_MODEL=typesafe/jev-1.13

# App
APP_URL=http://localhost:3000
PORT=3000

# Mode: replay (cache saja, 0 kr) | hybrid (cache dulu, live bila perlu) | live
INVESTIGRAPH_MODE=hybrid
SECTORS_DAILY_BUDGET=60
SECTORS_CONFIRM_ABOVE=6